# ==============================================================================
# MONGODB DATABASE CONFIGURATION
# ==============================================================================

# MongoDB Connection Settings
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=flights_scanner

# MongoDB Authentication - REQUIRED FOR PRODUCTION
# WARNING: These are secrets! Never commit actual credentials to version control
# For production: Set strong, unique credentials
# For development: You can use simple credentials, but NEVER use these in production
MONGO_USERNAME=admin
MONGO_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# MongoDB External Port (for direct database access from host)
MONGO_EXTERNAL_PORT=8902

# ==============================================================================
# AIRLINE CONFIGURATION
# ==============================================================================

# Airline IDs for route fetching
RYANAIR_AIRLINE_ID=39
WIZZAIR_AIRLINE_IDS=52,6002,6092

# Currency conversion rate EUR to PLN
# Used for converting EUR prices to PLN for consistent pricing display
EURO_PLN=4.23

# ==============================================================================
# RYANAIR SCRAPING CONFIGURATION
# ==============================================================================

# Ryanair cookie extraction URL
# This page triggers the availability API request which contains valid cookies
RYANAIR_COOKIE_URL=https://www.ryanair.com/hr/en/trip/flights/select?adults=1&teens=0&children=0&infants=0&dateOut=2026-03-06&dateIn=2026-03-08&isConnectedFlight=false&discount=0&promoCode=&isReturn=true&originIata=WRO&destinationIata=ALC&tpAdults=1&tpTeens=0&tpChildren=0&tpInfants=0&tpStartDate=2026-03-06&tpEndDate=2026-03-08&tpDiscount=0&tpPromoCode=&tpOriginIata=WRO&tpDestinationIata=ALC

# Delay between Ryanair API requests to avoid rate limiting (seconds)
RYANAIR_REQUEST_DELAY=0.5

# Max time to wait for cookie extraction from browser (seconds)
RYANAIR_COOKIE_WAIT_TIME=30

# Interval for checking cookie extraction progress (seconds)
RYANAIR_COOKIE_CHECK_INTERVAL=0.5

# ==============================================================================
# BACKEND API CONFIGURATION
# ==============================================================================

# Backend API port
BACKEND_PORT=8900

# API Key for protected endpoints (POST, PUT, DELETE operations)
# REQUIRED for security - set a strong, random key in production
# Use: openssl rand -hex 32  to generate a secure key
# Example: abc123def456ghi789jkl012mno345pqr678stu901vwx234yz
API_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY

# Enable API documentation (Swagger/OpenAPI docs)
# Set to 'false' in production to hide docs from public access
# Set to 'true' in development to access docs at /api/docs
# Default: false (docs disabled for security)
ENABLE_API_DOCS=false

# Number of Gunicorn worker processes (default: 4)
# Increase for high-traffic scenarios, decrease for low-memory environments
GUNICORN_WORKERS=4

# Worker timeout in seconds (default: 300)
# Max time a worker can take to process a request before being killed
WORKER_TIMEOUT=300

# Thread pool size for background flight scans (default: 4)
# Controls how many scans can run concurrently without blocking the API
MAX_SCAN_WORKERS=4

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================

# Frontend port
FRONTEND_PORT=8901

# Backend API base URL for server-side rendering (use internal Docker network URL)
API_BASE_URL=http://backend:8900

# Backend API base URL for client-side (browser) requests
# In production with nginx proxy, use the relative path: /api
# In development, use the full URL: http://localhost:8900
NUXT_PUBLIC_API_BASE_URL=/api

# ==============================================================================
# SCHEDULER CONFIGURATION
# ==============================================================================

# API URL for scheduler (internal Docker network URL)
API_URL=http://backend:8900

# Default trip duration for automatic scans (days)
TRIP_DURATION_DAYS=7

# How many days from now to scan (default: 140)
SCAN_UNTIL_DAYS=140

# ==============================================================================
# NGINX REVERSE PROXY (PRODUCTION ONLY)
# ==============================================================================

# Nginx HTTP port (production only, requires 'production' profile)
NGINX_HTTP_PORT=80

# Nginx HTTPS port (production only, requires 'production' profile)
NGINX_HTTPS_PORT=443
