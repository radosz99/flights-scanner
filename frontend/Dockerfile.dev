# Development Dockerfile for Nuxt Frontend with Hot Reload
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm ci

# Copy source code (will be overridden by volume mount in docker-compose.dev.yml)
COPY . .

# Expose port
EXPOSE 8901

# Set environment variables for network access
ENV HOST=0.0.0.0 \
    PORT=8901 \
    NODE_ENV=development

# Start development server with hot reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8901"]
